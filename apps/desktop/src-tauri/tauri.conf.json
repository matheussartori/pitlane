{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitlane",
  "version": "0.1.0",
  "identifier": "dev.pitlane.desktop",
  "build": {
    "beforeDevCommand": "node scripts/code-server.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/code-server.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pitlane",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#15181c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/code-server.tar.gz": "code-server.tar.gz",
      "resources/code-server.version": "code-server.version",
      "resources/vscode-extensions/": "vscode-extensions/"
    }
  }
}
